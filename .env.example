# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration — Allowed Frontend Origin(s), comma-separated if multiple
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Option A: Provide full service account JSON string (single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Option B: Provide individual service account fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
#
# Option C: Set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Google Gen AI SDK (@google/genai) Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Upload Limits
MAX_UPLOAD_MB=25
